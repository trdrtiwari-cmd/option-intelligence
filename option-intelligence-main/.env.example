# Never commit real credentials. Set these in Render Environment.
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://YOUR-APP.onrender.com/auth/callback
# Optional quick-start mode; Upstox standard access tokens expire and must be refreshed as required.
UPSTOX_ACCESS_TOKEN=

# --- Accounts (v1.10) ---------------------------------------------------------------------------------------
# PostgreSQL connection string for accounts + saved data (paper trades, settings). REQUIRED on Render: its free disk is
# erased on every restart, so without this every account would disappear. Leave empty locally to use a SQLite file.
# Example (Neon/Supabase/Render Postgres): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Invite code people must type to create an account (anyone who knows it can sign up - keep it private).
# If empty, only the FIRST account can be created (it becomes the owner) and sign-ups then close.
# (The old DASHBOARD_PASSWORD is used as the invite code if SIGNUP_CODE is empty.)
SIGNUP_CODE=

# Local development only: skip login entirely (a fixed "local" account is used). Never set this on a public server.
# AUTH_DISABLED=1

# Optional: protect the TradingView alert receiver. Use a long random value.
TRADINGVIEW_WEBHOOK_SECRET=replace_with_long_random_secret
# Optional log verbosity
LOG_LEVEL=INFO

# --- Reconfirmation + alerts (v1.14) ------------------------------------------------------------------------
# A new CE/PE setup is PENDING until it has held for this many seconds with price not moving against it (0 = off).
# The page's "Reconfirm hold" selector overrides this per browser.
RECONFIRM_SECONDS=60
RECONFIRM_MAX_ADVERSE_ATR=0.5
# Side-specific RSI limits (defaults shown). CE needs RSI_CE_MIN <= RSI <= RSI_CE_MAX, PE needs RSI_PE_MIN <= RSI <= RSI_PE_MAX.
# Scalp mode uses the *_SCALP limits when the price-structure trend is already confirmed. RSI_SLOPE=0 drops the rising/falling check.
# RSI_CE_MIN=60
# RSI_CE_MAX=68
# RSI_PE_MIN=32
# RSI_PE_MAX=40
# RSI_CE_MIN_SCALP=58
# RSI_PE_MAX_SCALP=42
# RSI_SLOPE=1
# Phone / email alerts. Server-side alerts work with the app/browser CLOSED, provided this backend stays awake.
# Render FREE web services can sleep when idle; use an always-on paid instance or external always-on worker for reliable monitoring.
# Use Telegram or ntfy (HTTPS) for phone push; browser notifications alone do NOT run in the background.
# 1) Telegram: create a bot with @BotFather, send it any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 2) ntfy: install the ntfy app, subscribe to a long random topic name, put the same name here (no account needed).
NTFY_TOPIC=
# 3) Email over HTTPS (Resend free tier): API key + your address. ALERT_EMAIL_FROM must be a verified sender (default onboarding@resend.dev sends to your own Resend login email).
RESEND_API_KEY=
ALERT_EMAIL_TO=
# 4) Plain SMTP (local or paid Render instance only): SMTP_HOST, SMTP_PORT (587/465), SMTP_USER, SMTP_PASS (+ ALERT_EMAIL_TO)
# Which events send a message: STARTED (setup detected), CONFIRMED (held the window), FAILED
ALERT_EVENTS=STARTED,CONFIRMED
# The server keeps watching when no browser tab is open (needs the service awake - ping /health every 10 min on a free host).
ALERT_BACKGROUND=1
ALERT_SYMBOLS=NIFTY,BANKNIFTY
ALERT_INTERVAL=5
ALERT_MODE=scalp
ALERT_SCORE_MIN=70
ALERT_POLL_SECONDS=10

# Native Android push (Firebase Admin service-account JSON; keep secret)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Browser/PWA Web Push VAPID keys - OPTIONAL since v1.18.6 (generated automatically and stored in the database)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Numeric owner account ID from GET /api/auth/me -> user.id. Required for background push/history routing.
PUSH_OWNER_USER_ID=
# Push devices/history are stored in the accounts database (DATABASE_URL), so no persistent disk is needed.
# Leave PUSH_OWNER_USER_ID empty to notify every account that registered a device.

# Self-ping every 10 min so a running Render service is not idled (set 0 to disable). RENDER_EXTERNAL_URL is provided by Render.
KEEPALIVE=1
# KEEPALIVE_URL=https://YOUR-APP.onrender.com

# Push delivery: how long the push service may hold an alert for a sleeping phone (seconds). 0 would drop it if the phone is in Doze.
PUSH_TTL_SECONDS=600

# v1.19 option buy plan (all optional; strike offset / lots / charges / min R:R can also be set on the Signals page)
# OPTION_STRIKE_STEPS=2
# OPTION_MONEYNESS=ITM
# OPTION_LOTS=1
# OPTION_CHARGES_RS=60
# OPTION_MIN_RR=1.5
# v1.19 signal timing switches
# SCORE_CAP=0            # 90 restores the old "score < 90" gate
# LAG_RELIEF=1           # 0 = ADX / Supertrend must agree on their own again (standard mode)
# CE_BLOCK_BREAKOUT=1    # strict = block every CE fresh breakout (old), 0 = no breakout gate
# v1.19.1
# FRESH_BREAK_BLOCK=1     # 1 = no entry on a fresh breakout/breakdown bar (default), quality = strong bars allowed, 0 = off
# EXIT_PLAN=balanced      # balanced | winrate (also on the Signals page)
# v1.19.5
# ENTRY_WINDOWS=09:45-12:00,14:30-15:00
# MIN_SL_ATR=1.5
# MIN_SL_PTS=20
# EXIT_PLAN=t1.5          # t1.5 | t2 | t3  (target in ATR; stop is always >= MIN_SL_ATR)

# v1.19.6 live socket push
# WS_TICK_SEC=0.1    # index + option prices checked / pushed (only when they move)
# WS_PUSH_SEC=0.1    # candles + analysis checked; pushed only when the server has a newer result

# v1.20.0 Claude strategy monitor (all optional; code checks run without a key)
# ANTHROPIC_API_KEY=sk-ant-...        # from the Anthropic Console; billed per use
# MONITOR_MODEL=claude-haiku-5-5      # short notes on losses / missed moves / rule breaks
# REVIEW_MODEL=claude-sonnet-5-5      # end-of-day review with suggested changes
# MONITOR_MAX_CALLS_PER_DAY=40
# MONITOR_REVIEW_MIN=30
# MONITOR_ENABLED=1  MONITOR_CLAUDE=1  MONITOR_PUSH=1
# v1.20.1 free AI option
# GEMINI_API_KEY=...                 # Google AI Studio (free tier, rate-limited; content may be used by Google)
# GEMINI_MODEL=gemini-flash-lite-latest
# MONITOR_PROVIDER=auto              # auto | claude | gemini | off
