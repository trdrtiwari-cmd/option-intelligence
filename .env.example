# Never commit real credentials. Set these in Render Environment.
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://YOUR-APP.onrender.com/auth/callback
# Optional quick-start mode; Upstox standard access tokens expire and must be refreshed as required.
UPSTOX_ACCESS_TOKEN=

# --- Accounts (v1.10) ---------------------------------------------------------------------------------------
# PostgreSQL connection string for accounts + saved data (paper trades, settings). REQUIRED on Render: its free disk is
# erased on every restart, so without this every account would disappear. Leave empty locally to use a SQLite file.
# Example (Neon/Supabase/Render Postgres): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Invite code people must type to create an account (anyone who knows it can sign up - keep it private).
# If empty, only the FIRST account can be created (it becomes the owner) and sign-ups then close.
# (The old DASHBOARD_PASSWORD is used as the invite code if SIGNUP_CODE is empty.)
SIGNUP_CODE=

# Local development only: skip login entirely (a fixed "local" account is used). Never set this on a public server.
# AUTH_DISABLED=1

# Optional: protect the TradingView alert receiver. Use a long random value.
TRADINGVIEW_WEBHOOK_SECRET=replace_with_long_random_secret
# Optional log verbosity
LOG_LEVEL=INFO

# --- Reconfirmation + alerts (v1.14) ------------------------------------------------------------------------
# A new CE/PE setup is PENDING until it has held for this many seconds with price not moving against it (0 = off).
# The page's "Reconfirm hold" selector overrides this per browser.
RECONFIRM_SECONDS=60
RECONFIRM_MAX_ADVERSE_ATR=0.5
# Side-specific RSI limits (defaults shown). CE needs RSI_CE_MIN <= RSI <= RSI_CE_MAX, PE needs RSI_PE_MIN <= RSI <= RSI_PE_MAX.
# Scalp mode uses the *_SCALP limits when the price-structure trend is already confirmed. RSI_SLOPE=0 drops the rising/falling check.
# RSI_CE_MIN=60
# RSI_CE_MAX=70
# RSI_PE_MIN=30
# RSI_PE_MAX=40
# RSI_CE_MIN_SCALP=58
# RSI_PE_MAX_SCALP=42
# RSI_SLOPE=1
# Phone / email alerts. Render FREE services block SMTP, so use one of the HTTPS channels. All optional; the browser beep needs none.
# 1) Telegram: create a bot with @BotFather, send it any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 2) ntfy: install the ntfy app, subscribe to a long random topic name, put the same name here (no account needed).
NTFY_TOPIC=
# 3) Email over HTTPS (Resend free tier): API key + your address. ALERT_EMAIL_FROM must be a verified sender (default onboarding@resend.dev sends to your own Resend login email).
RESEND_API_KEY=
ALERT_EMAIL_TO=
# 4) Plain SMTP (local or paid Render instance only): SMTP_HOST, SMTP_PORT (587/465), SMTP_USER, SMTP_PASS (+ ALERT_EMAIL_TO)
# Which events send a message: STARTED (setup detected), CONFIRMED (held the window), FAILED
ALERT_EVENTS=STARTED,CONFIRMED
# The server keeps watching when no browser tab is open (needs the service awake - ping /health every 10 min on a free host).
ALERT_BACKGROUND=1
ALERT_SYMBOLS=NIFTY
ALERT_INTERVAL=5
ALERT_MODE=scalp
ALERT_SCORE_MIN=70
